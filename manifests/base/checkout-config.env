# Non-secret application configuration, one KEY=value per line.
#
# This is loaded by configMapGenerator rather than being a committed
# ConfigMap resource, for two reasons:
#
#  1. kustomize appends a hash of the content to the generated name, so
#     changing a value here rolls the Deployment. A plain ConfigMap resource
#     would be updated in place and the running pods would keep the old values
#     until something unrelated restarted them.
#  2. An overlay can `behavior: merge` extra literals onto a generated
#     ConfigMap. It cannot merge onto a plain resource.
#
# Credentials never go here: a ConfigMap is plain text in etcd.
LOG_LEVEL=info
LISTEN_PORT=8080
FEATURE_RATE_LIMITING=false
UPSTREAM_TIMEOUT_SECONDS=5
